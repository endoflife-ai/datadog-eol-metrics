            "definition": {
              "title": "Products by Risk Grade",
              "title_size": "16",
              "title_align": "left",
              "description": "Share of monitored products by risk band — the widest wedges are where remediation effort concentrates.",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "query": "count:endoflife.risk_score{$detected} by {grade}",
                      "data_source": "metrics",
                      "name": "query1",
                      "aggregator": "max"
                    }
                  ],
                  "style": {
                    "palette": "datadog16"
                  },
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "sort": {
                    "count": 500,
                    "order_by": [
                      {
