            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "CISA KEV Exposure",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Active CISA KEV + Critical Products",
              "title_size": "16",
              "title_align": "left",
              "type": "toplist",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:endoflife.risk_score{kev_active:true,$detected} by {product}",
                      "aggregator": "avg"
                    }
                  ],
                  "response_format": "scalar",
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "sort": {
                    "count": 25,
                    "order_by": [
                      {
                        "type": "formula",
                        "index": 0,
                        "order": "desc"
                      }
                    ]
                  }
                }
              ],
              "style": {
                "display": {
                  "type": "stacked",
                  "legend": "automatic"
                }
              }
            },
            "layout": {
              "x": 4,
              "y": 9,
              "width": 4,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "Critical/KEV Risk Score Trend (30d)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value"
              ],
              "type": "timeseries",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "query1",
                      "data_source": "metrics",
                      "query": "avg:endoflife.risk_score{kev_active:true,$detected} by {product}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "top(query1, 8, 'mean', 'desc')"
                    }
                  ],
                  "style": {
                    "palette": "dog_classic",
                    "order_by": "values",
                    "line_type": "solid",
                    "line_width": "normal"
                  },
                  "display_type": "line"
                }
              ]
            },
            "layout": {
              "x": 8,
              "y": 9,
              "width": 4,
              "height": 2
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Product Detail & Trends",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "EOL Risk by product: score, days to end of life, grade, KEV, phase",
              "type": "query_table",
              "requests": [
                {
                  "queries": [
                    {
                      "name": "score",
                      "data_source": "metrics",
                      "query": "max:endoflife.risk_score{$product,$eol_phase,$grade,$detected} by {product,grade,kev_active,eol_phase}",
                      "aggregator": "max"
                    },
                    {
                      "name": "days",
                      "data_source": "metrics",
                      "query": "min:endoflife.days_until_eol{$product,$eol_phase,$grade,$detected} by {product,grade,kev_active,eol_phase}",
                      "aggregator": "min"
                    }
                  ],
                  "response_format": "scalar",
                  "formulas": [
                    {
                      "formula": "score",
                      "conditional_formats": [
                        {
                          "comparator": ">=",
                          "value": 80,
                          "palette": "white_on_red"
                        },
                        {
                          "comparator": ">=",
                          "value": 60,
                          "palette": "white_on_yellow"
                        },
                        {
                          "comparator": "<",
                          "value": 60,
                          "palette": "white_on_green"
                        }
                      ],
                      "alias": "EOL Risk Score"
                    },
                    {
                      "formula": "days",
                      "alias": "Days until EOL (negative = past)"
                    }
                  ],
                  "sort": {
                    "count": 100,
                    "order_by": [
                      {
                        "type": "formula",
                        "index": 0,
                        "order": "desc"
                      }
                    ]
                  }
                }
              ],
              "custom_links": [
                {
                  "label": "View {{product.value}} on endoflife.ai",
                  "link": "https://endoflife.ai/{{product.value}}"
                },
                {
                  "label": "Full risk-score methodology",
                  "link": "https://endoflife.ai/risk-score"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 11,
              "width": 12,
              "height": 4
            }
          },
          {
            "definition": {
              "title": "Risk posture trend (30d) — average score and past-EOL count",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "horizontal",
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "alias": "Average EOL Risk Score",
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "name": "query1",
                      "data_source": "metrics",
                      "query": "avg:endoflife.risk_score{$product,$eol_phase,$grade,$detected}"
                    }
                  ],
                  "response_format": "timeseries",
                  "style": {
                    "palette": "orange",
                    "line_type": "solid",
                    "line_width": "normal"
                  },
                  "display_type": "line"
                },
                {
                  "formulas": [
                    {
                      "alias": "Products past EOL",
                      "formula": "count_nonzero(query2)"
                    }
                  ],
                  "queries": [
                    {
                      "name": "query2",
                      "data_source": "metrics",
                      "query": "avg:endoflife.risk_score{eol_phase:past,$product,$grade,$detected} by {product}"
                    }
                  ],
                  "response_format": "timeseries",
                  "style": {
                    "palette": "warm",
                    "line_type": "dashed",
                    "line_width": "normal"
                  },
                  "display_type": "line",
                  "on_right_yaxis": true
                }
              ],
              "time": {
                "live_span": "1mo"
              }
            },
            "layout": {
              "x": 0,
              "y": 15,
              "width": 12,
              "height": 3
            }
          }
        ]
      }
    }
  ],
  "template_variables": [
    {
      "name": "product",
      "prefix": "product",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "eol_phase",
      "prefix": "eol_phase",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "grade",
      "prefix": "grade",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "detected",
      "prefix": "detected",
      "available_values": [
        "true",
        "false"
      ],
      "default": "true"
    }
  ],
  "layout_type": "ordered",
  "notify_list": [],
  "pause_auto_refresh": false,
  "reflow_type": "fixed"
}
